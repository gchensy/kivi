{
  "format": "kivi.FeatureSpec",
  "format_version": 1,
  "kivi_version": "1.3.0",
  "id": "customer",
  "observation_time": "date",
  "events": [
    {
      "table": "events",
      "time": "time",
      "windows": [
        "1M",
        "3M",
        [
          "6M",
          "3M"
        ],
        "90D"
      ],
      "aggregations": {
        "amount": [
          "count",
          "sum",
          "mean",
          "min",
          "max",
          "std",
          "first",
          "last",
          "days_since_last"
        ],
        "merchant": [
          "count",
          "nunique"
        ]
      },
      "closed": "left",
      "prefix": ""
    },
    {
      "table": "cash",
      "time": "time",
      "windows": [
        "3M"
      ],
      "aggregations": {
        "amount": [
          "sum"
        ]
      },
      "closed": "left",
      "prefix": "cash_"
    },
    {
      "table": "balances",
      "time": "day",
      "windows": [
        "30D",
        [
          "60D",
          "30D"
        ]
      ],
      "aggregations": {
        "balance": [
          "mean",
          "last"
        ]
      },
      "closed": "right",
      "prefix": "daily_"
    }
  ],
  "ratios": [
    [
      "amount_sum_3m",
      "amount_sum_6m_3m"
    ],
    [
      "cash_amount_sum_3m",
      "amount_sum_3m"
    ],
    [
      "daily_balance_mean_30d",
      "daily_balance_mean_60d_30d"
    ],
    [
      "bad_months_6m",
      "months_6m"
    ]
  ],
  "panel": [
    {
      "table": "loans",
      "month": "month",
      "status": "status",
      "windows": [
        "6M",
        "12M",
        [
          "12M",
          "6M"
        ]
      ],
      "bad": "30-59",
      "prefix": ""
    },
    {
      "table": "loans",
      "month": "month",
      "status": "status",
      "windows": [
        "12M"
      ],
      "bad": "90+",
      "prefix": "severe_"
    }
  ]
}
